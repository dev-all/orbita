# Sin cuentas ni credenciales: catálogo ficticio y checkout sin cobros.
CATALOG_SOURCE=demo
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon > proyecto > Connect. Usar conexión pooled para DATABASE_URL.
# Cambiar CATALOG_SOURCE=database únicamente después de migrar y cargar datos.
DATABASE_URL=
DATABASE_IPV4_ONLY=false
# Conexión directa del mismo proyecto para migraciones; no la de producción.
DIRECT_URL=

# Confirmar el CP con el domicilio antes de activar cotizaciones reales.
SHIPPING_ORIGIN_POSTAL_CODE=1643

# Futuras integraciones. Nunca usar claves de producción en desarrollo.
# Mercado Pago > Tus integraciones > aplicación > Credenciales de prueba.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Clerk > aplicación Development > API Keys. Sin estas claves no hay administración real.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# MiCorreo: solicitar credenciales QA. No se consulta el proveedor en modo demo.
CORREO_API_USERNAME=
CORREO_API_PASSWORD=
# Número comercial con país y área, solo dígitos. Vacío = sin enlace de WhatsApp.
WHATSAPP_NUMBER=

# IDs de usuarios de Clerk autorizados para administrar; separados por comas.
ADMIN_USER_IDS=
